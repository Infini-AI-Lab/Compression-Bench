# Kimi K3.1 Pro on OpenRouter through Claude Code's Anthropic-compatible route.
# Copy to a private location, fill in the key, and pass it as AGENT_ENV=<file> to evolve-task.sh.
# The scheduler (scripts/scheduler.py AGENTS) reads it as $COMPRESSION_BENCH_CONFIG_DIR/kimi-k3p1-pro-openrouter.env
# (default ~/.config/compression_bench/kimi-k3p1-pro-openrouter.env); keep it mode 600.
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_API_KEY=<your OpenRouter API key>
ANTHROPIC_AUTH_TOKEN=<your OpenRouter API key>
ANTHROPIC_MODEL=moonshotai/kimi-k3.1-pro
ANTHROPIC_SMALL_FAST_MODEL=moonshotai/kimi-k3.1-pro
ANTHROPIC_DEFAULT_OPUS_MODEL=moonshotai/kimi-k3.1-pro
ANTHROPIC_DEFAULT_SONNET_MODEL=moonshotai/kimi-k3.1-pro
ANTHROPIC_DEFAULT_HAIKU_MODEL=moonshotai/kimi-k3.1-pro
CLAUDE_CODE_SUBAGENT_MODEL=moonshotai/kimi-k3.1-pro
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1048576
