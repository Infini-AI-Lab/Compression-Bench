# GLM-5.3-Flash on Fireworks through Claude Code's Anthropic-compatible route.
# Copy to a private location, fill in the key, and pass it as AGENT_ENV=<file> to evolve-task.sh.
# The scheduler (scripts/scheduler.py AGENTS) reads it as $COMPRESSION_BENCH_CONFIG_DIR/glm-5p3-flash-fireworks.env
# (default ~/.config/compression_bench/glm-5p3-flash-fireworks.env); keep it mode 600.
ANTHROPIC_BASE_URL=https://api.fireworks.ai/inference
ANTHROPIC_API_KEY=<your Fireworks API key>
ANTHROPIC_AUTH_TOKEN=<your Fireworks API key>
ANTHROPIC_MODEL=accounts/fireworks/models/glm-5p3-flash
ANTHROPIC_SMALL_FAST_MODEL=accounts/fireworks/models/glm-5p3-flash
ANTHROPIC_DEFAULT_OPUS_MODEL=accounts/fireworks/models/glm-5p3-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=accounts/fireworks/models/glm-5p3-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=accounts/fireworks/models/glm-5p3-flash
CLAUDE_CODE_SUBAGENT_MODEL=accounts/fireworks/models/glm-5p3-flash
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1048576
